    "check:start": "node scripts/check-start-screen.mjs",
    "check:hud": "node scripts/check-hud.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "check:story": "node scripts/check-storybook.mjs",
    "check:music": "node scripts/check-music.mjs",
    "check:sfx": "node scripts/check-sfx.mjs",
    "check:crossing": "node scripts/check-crossing.mjs",
